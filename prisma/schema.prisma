generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique(map: "Admin_username_key")
  password  String
  createdAt DateTime
}

model reservations {
  id             BigInt   @id @default(autoincrement())
  type           String
  category       String
  use_date       DateTime
  nights         Int
  quantity       Int
  guest_name     String
  phone          String
  people_count   Int
  user_type      String
  total_amount   Int
  extra_amount   Int      @default(0)
  payment_status String
  deposit_date   DateTime
  cancel_date    DateTime
  source         String
  memo           String
  created_at     DateTime @default(now())
  updated_at     DateTime
}

// --- StayNamcheon Management Models (NEW) ---

model StayAdmin {
  id        String   @id @default(cuid())
  adminId   String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stay_admins")
}

model StayPageContent {
  id          String   @id @default(cuid())
  page        String   // e.g., "home", "pension", "cafe"
  section     String   // e.g., "hero", "about"
  key         String   // e.g., "title", "description", "imageUrl"
  value       String   @db.Text
  type        String   @default("text") // "text", "image", "number"
  category    String?  // Optional grouping
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([page, section, key])
  @@map("stay_page_contents")
}

model StayGalleryItem {
  id          String   @id @default(cuid())
  title       String?
  description String?
  imageUrl    String
  publicId    String?
  videoUrl    String?
  type        String   @default("image") // "image", "video"
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  isMain      Boolean  @default(false)
  category    String?  // e.g., "interior", "exterior", "landscape"
  pages       String?  // JSON array of "page>section" tags e.g. ["gallery>gallery","cafe>gallery"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stay_gallery_items")
}

model PageView {
  id             String   @id @default(cuid())
  path           String
  referrer       String?
  referrerDomain String?
  userAgent      String?
  browser        String?
  os             String?
  device         String?
  ipHash         String?
  sessionId      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([referrerDomain])
  @@map("page_views")
}

model StayStory {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  images      String?  // JSON array of image URLs
  tags        String?  // JSON array of tags, e.g. ["#스테이남천", "#벚꽃놀이"]
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stay_stories")
}

// ============================================================
// 실시간 채팅 (Visitor Chat)
// ============================================================

model ChatVisitor {
  id        String   @id @default(cuid())
  token     String   @unique            // UUID cookie
  nickname  String                      // 자동생성 "0405_1423"
  createdAt DateTime @default(now())
  room      ChatRoom?

  @@map("chat_visitors")
}

model ChatRoom {
  id        String   @id @default(cuid())
  visitorId String   @unique @map("visitor_id")
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitor   ChatVisitor   @relation(fields: [visitorId], references: [id])
  messages  ChatMessage[]

  @@index([updatedAt])
  @@map("chat_rooms")
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String   @map("room_id")
  senderType String   @map("sender_type") // 'visitor' | 'admin'
  content    String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model AdminPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  adminId   String   @map("admin_id")   // "stay"
  createdAt DateTime @default(now())

  @@map("admin_push_subscriptions")
}
